[alias]
  # add
  a = add
  aa = add --all
  ap = add -p

  # branch
  b = branch
  bd = branch -D
  bm = branch --move
  br = branch --remotes
  bu = branch --set-upstream-to

  # checkout
  co = checkout
  cob = checkout -b

  # cherry-pick
  cp = cherry-pick
  cpa = cherry-pick --abort
  cpc = cherry-pick --continue
  cpn = cherry-pick --no-commit
  cpx = cherry-pick -x

  # clean
  cleand = clean --force -d
  cleandx = clean --force -d -x

  # clone
  cl = clone --recurse-submodules

  # commit
  c = commit --signoff
  ca = commit --signoff --all
  cad = commit --signoff --all --amend
  cadn = commit --signoff --all --amend --no-edit
  caf = commit --all --fixup
  cam = commit --signoff --all --message
  cd = commit --signoff --amend
  cdn = commit --signoff --amend --no-edit
  cf = commit --fixup
  cm = commit --signoff --message

  # diff
  df = diff
  dt = difftool

  # log
  l = log --reverse --oneline --date=format:'%d/%m/%Y' --pretty=log
  lf = log --reverse --oneline --date=format:'%d/%m/%Y' --pretty=log --follow
  lg = log --reverse --oneline --date=format:'%d/%m/%Y' --pretty=log -i --grep
  ll = log --reverse --oneline --date=format:'%d/%m/%Y' --pretty=log -50 --no-merges

  # merge
  mt = mergetool

  # pull
  pl = pull --no-recurse-submodules
  pln = pull --no-recurse-submodules --no-rebase

  # push
  ps = push
  psf = push --force origin HEAD

  # rebase
  rb = rebase
  rba = rebase --abort
  rbc = rebase --continue
  rbi = rebase --interactive
  rbq = rebase --quit

  # reflog
  rl = reflog --pretty=reflog
  rll = reflog --pretty=reflog -50

  # remote
  radd = remote add
  rset = remote set-url
  rv = remote -v

  # reset
  r = reset
  rh = reset --hard

  # show
  sh = show
  shq = show --oneline --date=format:'%d/%m/%Y' --pretty=log --name-status

  # status
  s = status

  # stash
  sta = stash apply
  std = stash drop
  stl = stash list
  stp = stash pop
  stu = stash -u

  # submodule
  sb = submodule
  sbu = submodule update --rebase --remote

  # tag
  t = tag
  ta = tag --annotate
  td = tag --delete
  taf = tag --force --annotate
[blame]
  coloring = highlightRecent
  date = format:%d/%m/%Y
[branch]
  autoSetupMerge = always
  autoSetupRebase = always
[clean]
  requireForce = false
[commit]
  gpgSign = true
[core]
  autocrlf = input
  editor = code --wait
  eol = lf
  pager = cat
[diff]
  tool = vscode
[difftool]
  prompt = false
[difftool "vscode"]
  cmd = code --wait --diff "$LOCAL" "$REMOTE"
[fetch]
  prune = true
  pruneTags = true
[gpg]
  format = ssh
[init]
  defaultBranch = main
[log]
  date = iso-local
[merge]
  tool = vscode
[mergetool]
  keepBackup = false
  keepTemporaries = false
  prompt = false
[mergetool "vscode"]
  cmd = code --wait "$MERGED"
[pretty]
  log = %C(bold red)%h %C(bold blue)%ad %C(bold cyan)%aN%C(auto):%d %s
  reflog = %C(bold red)%h %C(bold blue)%gd%C(auto)%d %gs
[pull]
  rebase = true
[push]
  default = current
  followTags = true
  recurseSubmodules = on-demand
[rebase]
  autoSquash = true
  autoStash = true
  missingCommitsCheck = warn
[rerere]
  enabled = true
[status]
  branch = true
  showStash = true
  showUntrackedFiles = all
[submodule]
  fetchJobs = 16
[tag]
  gpgSign = true
[user]
  email = 302163495+tupl-dev@users.noreply.github.com
  name = tupl
  signingKey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIcBnTO65xAwkiP9DeZ5HkDO5PN8Rokujp+QlDJ7OZ/n

# uncomment below for SSH instead of HTTPS
# [url "git@github.com:"]
#   insteadOf = https://github.com/

# uncomment below for Windows
# [core]
#   sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
# [gpg "ssh"]
#   program = C:/Windows/System32/OpenSSH/ssh-keygen.exe
